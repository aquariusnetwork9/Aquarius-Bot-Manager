# Runtime config (contains instance roster, theme, and the PBKDF2 password hash)
instances.json

# Fleet registry (contains the DigitalOcean API token + agent credentials)
fleet.json

# Node registry (controller mode — contains SSH targets + node web credentials)
nodes.json

# Python
__pycache__/
*.py[cod]

# Windows exe build output (built by build_windows_exes.ps1; see that
# script's docstring for how to reproduce it -- not checked in since it's
# large, machine-specific, and trivially rebuildable)
/build/
/dist/
*.spec

# Installer build output + bundled third-party binary (nssm.exe -- not ours
# to commit; installer.iss's own comment says where to get it)
/installer_output/
/nssm.exe
