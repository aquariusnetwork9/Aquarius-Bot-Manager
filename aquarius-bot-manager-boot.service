[Unit]
Description=Start autostart Aquarius/Zenith proxy instances
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# --- edit these ---
User=ubuntu
WorkingDirectory=/opt/aquarius-bot-manager
ExecStart=/usr/bin/python3 /opt/aquarius-bot-manager/manager.py boot
RemainAfterExit=yes
# Bots launched here share this service's cgroup; KillMode=process means stopping the
# unit never cascade-kills them (they're managed via tmux by the manager, not systemd).
KillMode=process
# Where instances.json lives (if not next to manager.py):
# Environment=ABM_CONFIG=/opt/aquarius-bot-manager/instances.json

[Install]
WantedBy=multi-user.target
